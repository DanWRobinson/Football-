# Copy to .env and fill in what you have. Everything is optional.
# Paid: API-Football (api-sports.io) - adds xG/shots for every league incl. National League
API_FOOTBALL_KEY=
# Max per-fixture stat requests per run (free tier = 100 requests/day)
API_FOOTBALL_MAX_CALLS=90
# FotMob request header if their API starts returning 401/403 (copy from browser dev tools)
FOTMOB_XMAS=
# Cap on FotMob match-detail requests per league per run (cached forever once fetched)
FOTMOB_MAX_MATCHES=400
# Seconds between requests to the same site
FOOTY_MIN_INTERVAL=1.5
# LFC ticket alerts: your private ntfy topic (install the free ntfy app and subscribe to it)
NTFY_TOPIC=
# Optional ntfy access token (free ntfy.sh account) so the message limit is yours, not shared
NTFY_TOKEN=
# Live UK bookmaker/exchange odds (the-odds-api.com, free 500 credits/month)
ODDS_API_KEY=
